# Archivos temporales del sistema operativo
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Archivos temporales y de respaldo del editor
*~
*.swp
*.swo
*.tmp
*.temp

# Respaldos locales del planeta Minecraft; conservar fuera del commit
/assets/models/planets/minecraft/backups/
/assets/models/planets/minecraft/*.blend[0-9]*

# Copia local previa al refinamiento del planeta South Park
/docs/references/southpark/backups/
/assets/models/planets/southpark/*.blend[0-9]*

# Respaldos automáticos de Blender del planeta Smiling Friends
/assets/models/planets/smilingfriends/*.blend[0-9]*
/assets/models/characters/smilingfriends/*.blend[0-9]*

# Respaldos locales del planeta starwars
/assets/models/planets/starwars/*.blend[0-9]*
/assets/models/planets/starwars/backups/
/tools/blender/starwars/__pycache__/

# Respaldos locales del planeta regularshow
/assets/models/planets/regularshow/*.blend[0-9]*
/assets/models/planets/regularshow/backups/
/tools/blender/regularshow/__pycache__/
